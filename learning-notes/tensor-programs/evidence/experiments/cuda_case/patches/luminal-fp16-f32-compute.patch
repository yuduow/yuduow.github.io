@@ -69,3 +69,33 @@
   :name "cuda_lite/cublaslt/egg/cublaslt_marker_site: BF16 matmul with F32 output"
 )
 ; ============================================================================
+
+; FP16 storage with explicit FP32 arithmetic. Widening FP16 to FP32 is
+; exact; an FP16 product fits in FP32. Consume the original storage while
+; retaining the F32 result and reduction contract. This is NOT a rule for
+; cast(F16 matmul, F32): that graph rounds products/reduction in F16.
+(rule
+  (
+    (= ?out (LogicalHelperMatrixMultiply ?aw ?bw))
+    (= ?aw (LogicalCast ?a (F32)))
+    (= ?bw (LogicalCast ?b (F32)))
+    (= (dtype-of ?a) (F16))
+    (= (dtype-of ?b) (F16))
+    (= (dtype-of ?out) (F32))
+  )
+  ((let ?site (CublasLtLogicalMatmulSite ?a ?b ?out)))
+  :ruleset backend
+  :name "cuda_lite/cublaslt/egg/cublaslt_marker_site: FP16 storage with explicit FP32 arithmetic"
+)
+
+; Let the existing F32 transpose-sandwich rule expose the same exact
+; widening on a transposed operand. Transposition changes indices only.
+(rule
+  (
+    (= ?out (LogicalHelperMatrixTranspose (LogicalCast ?a (F32))))
+    (= (dtype-of ?a) (F16))
+  )
+  ((union ?out (LogicalCast (LogicalHelperMatrixTranspose ?a) (F32))))
+  :ruleset backend
+  :name "cuda_lite/cublaslt/egg/cublaslt_marker_site: transpose commutes with FP16 widening"
+)
